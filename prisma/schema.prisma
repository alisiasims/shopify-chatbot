generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  assistant
}

model ChatSession {
  id             String        @id @default(cuid())
  title          String        @default("New Chat")
  model          String        @default("gpt-4")
  temperature    Float         @default(0.7)
  topP           Float         @default(1.0)
  systemPromptId String?
  systemPrompt   SystemPrompt? @relation(fields: [systemPromptId], references: [id], onDelete: SetNull)
  /// "app" = admin/homework chat, "web" = site widget, "email", "instagram", "messenger"
  channel        String        @default("app")
  /// widget visitor id (browser) or the sender id / Gmail thread id on other channels
  visitorId      String?
  externalId     String?
  customerName   String?
  customerEmail  String?
  lang           String?
  pageUrl        String?
  needsHuman     Boolean       @default(false)
  /// a person checked Deisi's answers up to this moment (inbox «Проверить», owner 06.11)
  reviewedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  messages       Message[]
  handoffs       Handoff[]
  followUps      FollowUp[]

  @@index([updatedAt])
  @@index([channel, updatedAt])
  @@index([visitorId])
  @@unique([channel, externalId])
}

model Message {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      Role
  content   String
  /// [{name, type, size}] - file data itself is not stored
  attachments Json?
  /// product cards, cart link and tools used for this reply
  meta      Json?
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model SystemPrompt {
  id        String        @id @default(cuid())
  name      String        @unique
  content   String
  createdAt DateTime      @default(now())
  sessions  ChatSession[]
}

/// Cache of the public deesse.ee catalog (products.json), refreshed every few hours.
model Product {
  id          String   @id
  handle      String   @unique
  title       String
  tags        String[]
  productType String   @default("")
  body        String   @default("")
  image       String?
  priceMin    Float
  priceMax    Float
  compareAt   Float?
  inStock     Boolean  @default(true)
  options     Json
  variants    Json
  url         String
  syncedAt    DateTime @default(now())

  @@index([syncedAt])
}

/// A conversation that needs a person (complaint, return, order problem, wholesale, the client asked for a human).
model Handoff {
  id        String       @id @default(cuid())
  sessionId String?
  session   ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  channel   String
  reason    String
  summary   String
  contact   String?
  status    String       @default("open")
  notified  Boolean      @default(false)
  createdAt DateTime     @default(now())

  @@index([status, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// How our people answered clients (Instagram / Messenger / Gmail history, corrected drafts). Deisi sees the most similar ones.
model Example {
  id        String   @id @default(cuid())
  question  String
  answer    String
  /// instagram, messenger, gmail, telegram_edit, import
  source    String
  lang      String?
  /// message id in the source, so an import can run again without duplicates
  sourceId  String?  @unique
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}

/// Corrections from the owner and admins (/fix in Telegram). Newer than the knowledge, they override it.
model Rule {
  id        String   @id @default(cuid())
  text      String
  by        String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

/// Copy of the shop team's Telegram chat (owner 05.11: Claude reads it and writes to the team, like TgLog at the studio). Kept 30 days.
model TeamLog {
  id        String   @id @default(cuid())
  /// in = a person in the team chat, out = Deisi / Claude to the team
  dir       String
  who       String?
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Deisi's own follow-ups to clients who went quiet one step before buying (owner 06.11, like at the studio).
model FollowUp {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  /// link = cart / payment link not paid, chat = went quiet after a product question
  kind      String
  channel   String
  text      String
  /// sent = Deisi sent it, draft = a person sends it (e-mail, or Meta sending off), failed, done = a person handled the draft
  status    String
  reason    String?
  createdAt DateTime    @default(now())
  doneAt    DateTime?

  @@index([status, createdAt])
  @@index([sessionId, createdAt])
}
