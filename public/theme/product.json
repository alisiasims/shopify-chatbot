        "custom_liquid_kdd99H": {
          "type": "custom-liquid",
          "disabled": true,
          "settings": {
            "custom_liquid": "<div data-deesse-pickup-root=\"{{ product.id }}\">\n  <div data-deesse-pickup-block style=\"display:none; margin-top:20px;\">\n    <div style=\"margin-bottom:16px;\">\n\n      <div style=\"font-size:15px; margin-bottom:4px; font-weight:400;\">\n        <span style=\"color:#1a7f37;\">✔</span>\n        Pickup available at\n        <span style=\"font-weight:600;\">DEESSE Shop</span>\n      </div>\n\n      <div style=\"font-size:14px; color:#666; font-weight:400;\">\n        {%- comment -%}\n        Yahan apni exact address line dal do (static).\n        {%- endcomment -%}\n        {{ shop.address.address1 }}{% if shop.address.address2 != blank %}, {{ shop.address.address2 }}{% endif %}{% if shop.address.city != blank %}, {{ shop.address.city }}{% endif %}{% if shop.address.zip != blank %}, {{ shop.address.zip }}{% endif %}{% if shop.address.country != blank %}, {{ shop.address.country }}{% endif %}\n      </div>\n\n    </div>\n  </div>\n\n  <script type=\"application/json\" data-deesse-qty-map>\n    {\n      {% for v in product.variants %}\n        \"{{ v.id }}\": {{ v.inventory_quantity | default: 0 }}{% unless forloop.last %},{% endunless %}\n      {% endfor %}\n    }\n  </script>\n</div>\n\n<script>\n(function () {\n\n  function init() {\n    document.querySelectorAll('[data-deesse-pickup-root]').forEach(root => {\n      // ✅ per-block guard\n      if (root.__deessePickupInited) return;\n      root.__deessePickupInited = true;\n\n      const block = root.querySelector('[data-deesse-pickup-block]');\n      const mapTag = root.querySelector('[data-deesse-qty-map]');\n      if (!block || !mapTag) return;\n\n      let qtyMap = {};\n      try { qtyMap = JSON.parse(mapTag.textContent.trim()); } catch(e) {}\n\n      const variantEl = document.querySelector('variant-selection');\n      const selectEl =\n        document.querySelector('variant-selection select[name=\"id\"]') ||\n        document.querySelector('select[name=\"id\"]');\n\n      function getVariantId() {\n        const v1 = selectEl?.value;\n        if (v1 && v1 !== 'not-selected') return v1;\n\n        const v2 = variantEl?.getAttribute('variant');\n        if (v2) return v2;\n\n        return null;\n      }\n\n      function show() { block.style.display = \"\"; }\n      function hide() { block.style.display = \"none\"; }\n\n      function update() {\n        const vid = getVariantId();\n        if (!vid) return hide();\n\n        const q = Number(qtyMap[String(vid)] ?? 0);\n\n        // ✅ ONLY real stock > 0 (ignore continue selling)\n        if (q >= 1) show();\n        else hide();\n      }\n\n      update();\n      root.__timer = setInterval(update, 200);\n    });\n  }\n\n  // Run on load\n  if (document.readyState === \"loading\") {\n    document.addEventListener(\"DOMContentLoaded\", init);\n  } else {\n    init();\n  }\n\n  // Theme editor events\n  document.addEventListener('shopify:section:load', init);\n  document.addEventListener('shopify:section:reorder', init);\n  document.addEventListener('shopify:section:select', init);\n\n})();\n</script>"
          }
