# Railway → app service → Variables. Never put real values in code or Git.

# PostgreSQL (Railway reference variable)
DATABASE_URL="${{Postgres.DATABASE_URL}}"

# Claude - switches on the real assistant (without it: demo answers)
ANTHROPIC_API_KEY=""
# optional, default claude-sonnet-5-5
ANTHROPIC_MODEL=""

# Inbox with customer conversations at /inbox (HTTP login, user "deesse")
ADMIN_PASSWORD=""

# Telegram messages to the team about handoffs and social drafts.
# Only the token is needed: add the bot to the admin group and write /here in the topic.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""      # optional, overrides /here
TELEGRAM_THREAD_ID=""    # optional, overrides /here

# Gmail bridge (integrations/gmail-bridge.gs) - a long random text, the same in the Apps Script
EMAIL_BRIDGE_TOKEN=""

# Order status lookup (Shopify custom app with read_orders)
SHOPIFY_STORE_DOMAIN=""   # e.g. deesse-ee.myshopify.com
SHOPIFY_ADMIN_TOKEN=""

# A real Shopify discount code Deisi may offer once when a client hesitates on price
DISCOUNT_CODE=""
DISCOUNT_LABEL="10%"

# Instagram / Messenger webhook (/api/meta)
META_VERIFY_TOKEN=""
META_APP_SECRET=""
META_PAGE_TOKEN=""
META_AUTO_REPLY=""        # "on" sends answers directly; otherwise drafts go to Telegram

# optional
SHOP_URL="https://deesse.ee"
WIDGET_ORIGINS=""
APP_URL=""
